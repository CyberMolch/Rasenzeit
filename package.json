{
  "name": "rasenzeit",
  "private": true,
  "version": "0.1.0",
  "description": "Rasenzeit – unabhängiger Pflegebegleiter für den Rasen (Web-App und Android-App)",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --dev && npx --yes serve dist -l 4173",
    "typecheck": "tsc -p tsconfig.json",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
